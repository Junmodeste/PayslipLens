# Copy to .env.local and fill in with your own Firebase web app config
# (Firebase console > Project settings > Your apps > Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA v3 site key (public) used by App Check. The secret key goes only in Firebase console.
VITE_RECAPTCHA_SITE_KEY=
# Optional, local dev only: a registered App Check debug token. Never commit it.
VITE_APPCHECK_DEBUG_TOKEN=
